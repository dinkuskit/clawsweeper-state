{
  "name": "@dinkuskit/canonical-review-state",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "types": "wrangler types --include-runtime false",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run types && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260930.2",
    "@types/node": "24.19.0",
    "miniflare": "5.20260930.0-alpha",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "wrangler": "4.145.0"
  }
}
